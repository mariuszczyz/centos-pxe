# PXE boot menu generated by Ansible. Do not edit on the host.
default menu.c32
prompt 0
timeout 100
ONTIMEOUT 1

menu title PXE Boot Menu

label 1
menu label ^1) Boot from local drive
localboot 0
menu default
{% set ns = namespace(n=1) %}
{% for iso in pxe_isos %}
{% set ns.n = ns.n + 1 %}

label {{ ns.n }}
menu label ^{{ ns.n }}) Install {{ iso.name }} manually (graphical)
kernel {{ iso.name }}/vmlinuz
append initrd={{ iso.name }}/initrd.img inst.repo=http://{{ ansible_default_ipv4['address'] }}/{{ iso.name }} devfs=nomount
{% endfor %}
{% for ks in pxe_kickstarts %}
{% set ns.n = ns.n + 1 %}

label {{ ns.n }}
menu label ^{{ ns.n }}) {{ ks.label }}
kernel {{ ks.iso }}/vmlinuz
append initrd={{ ks.iso }}/initrd.img vga=normal ks=http://{{ ansible_default_ipv4['address'] }}/kickstart/{{ ks.name }}.cfg ksdevice=bootif
{% endfor %}

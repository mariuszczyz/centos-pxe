# PXE Boot Menu Configuration
# Supports CentOS Stream 9/10 and Fedora 40/41

default menu.c32
prompt 0
timeout 100
ONTIMEOUT 1

menu title ########## PXE Boot Menu ##########

label 1
menu label ^1) Boot from local drive. Do not install anything.
localboot 0
menu default

{% for iso in ISOS %}
label {{ loop.index + 1 }}
menu label ^{{ loop.index + 1 }}) Install {{ iso.NAME }} Manually with graphical GUI
kernel {{ iso.NAME }}/vmlinuz
append initrd={{ iso.NAME }}/initrd.img method=http://{{ ansible_default_ipv4.address }}/{{ iso.NAME }} devfs=nomount
{% endfor %}

{% for iso in ISOS %}
label {{ loop.index + 1 + ISOS|length }}
menu label ^{{ loop.index + 1 + ISOS|length }}) Unattended {{ iso.NAME }} Kickstart Install in Text Mode
kernel {{ iso.NAME }}/vmlinuz
append vga=normal initrd={{ iso.NAME }}/initrd.img ks=http://{{ ansible_default_ipv4.address }}/kickstart/{{ iso.NAME }}-base.cfg ksdevice=bootif
{% endfor %}
